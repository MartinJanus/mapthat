# No environment variables are required for the application foundation.
# Add documented placeholders when integrations are introduced.


# INSTAGRAM_ACCESS_TOKEN = replace_with_your_token --- IGNORE ---
# INSTAGRAM_ACCOUNT_ID = replace_with_your_account_id --- IGNORE ---

# Only the Instagram webhook needs these server-side values.
# Copy into an ignored .env or .env.local and populate privately.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# App Secret for the Meta app hosting the webhook, not the verify token.
INSTAGRAM_APP_SECRET=
# Choose a random nonempty value; use the same in Meta's form.
INSTAGRAM_VERIFY_TOKEN=
# Pinned version from the official Instagram Login messaging documentation.
INSTAGRAM_API_VERSION=v25.0

# Gemini caption interpretation for the caption-first place-extraction prototype.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Google Places (New) matching and photos. Enable the API in the
# Google Cloud project; keep this server-side key restricted to Places API.
# Without this key, cards contain explicitly unverified caption search links.
GOOGLE_PLACES_API_KEY=

# Enable only after confirming permission to process media received in Reel webhooks.
# Requires a direct Meta CDN video URL; Instagram page links are not downloadable media.
INSTAGRAM_VIDEO_FALLBACK_ENABLED=false

# Optional backend-only request tracking. Set all three to enable it.
# Create a secret API key in Supabase Settings > API Keys. Never use NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Generate a stable random value of at least 32 characters; keep across deploys.
TRACKING_HASH_SECRET=
